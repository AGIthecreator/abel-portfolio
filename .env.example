# =============================================================================
# Plantilla pública. Copiar a `.env.local` y rellenar.
# Nunca commitear `.env.local`. Ninguna clave sensible lleva NEXT_PUBLIC_.
# =============================================================================

# --- Sitio (contacto / presupuesto). El laboratorio NO las usa. ---
RESEND_API_KEY=
CONTACT_EMAIL=

# --- Laboratorio: email propio. Sin fallback a RESEND_API_KEY / CONTACT_EMAIL. ---
# Si faltan, la demo sigue y el email queda como SIMULACIÓN.
LAB_RESEND_API_KEY=
LAB_CONTACT_EMAIL=
# Opcional. Debe ser de un dominio verificado en Resend.
# Ejemplo: AGI Laboratorio <contacto@agithecreator.com>
LAB_EMAIL_FROM=
# Opcional. Tope global de emails reales del laboratorio por día. Por defecto 40.
LAB_DAILY_EMAIL_BUDGET=40

# --- Laboratorio: persistencia propia. Sin fallback a SUPABASE_* genéricas. ---
# Si faltan, la demo sigue con memoria de proceso (no sobrevive a serverless).
LAB_SUPABASE_URL=
LAB_SUPABASE_SERVICE_ROLE_KEY=

# --- Opcional: aplicar el esquema SQL desde aquí (una de las dos vías). ---
# Project ref = subdominio de la URL (xxxx en https://xxxx.supabase.co)
LAB_SUPABASE_PROJECT_REF=
# Contraseña de la base (Settings → Database). Solo para psql / aplicar lab.sql.
LAB_SUPABASE_DB_PASSWORD=
# O Access Token de cuenta (https://supabase.com/dashboard/account/tokens)
# para el Management API. No es la service role.
LAB_SUPABASE_ACCESS_TOKEN=

# --- Público (no son secretos del laboratorio) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GA_ID=
